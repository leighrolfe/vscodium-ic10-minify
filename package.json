{
  "name": "ic10-minify",
  "displayName": "IC10 Minify",
  "description": "Minify Stationeers IC10 code by stripping comments and whitespace.",
  "version": "0.0.3",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ic10Minify.openMinified",
        "title": "IC10: Minify (Open in New Editor)"
      },
      {
        "command": "ic10Minify.copyMinified",
        "title": "IC10: Minify (Copy to Clipboard)"
      }
    ]
  },
  "overrides": {
    "vulnerable-package-name": "latest-safe-version"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node scripts/run-tests.js",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2"
  }
}
