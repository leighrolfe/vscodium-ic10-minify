{
  "name": "ic10-minify",
  "displayName": "IC10 Minify",
  "description": "Minify Stationeers IC10 code by stripping comments and whitespace, then compressing aliases.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ic10Minify.openMinified",
        "title": "IC10: Minify to File"
      },
      {
        "command": "ic10Minify.copyMinified",
        "title": "IC10: Minify to Clipboard"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node scripts/run-tests.js",
    "package": "npm run compile && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.143.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.1": true,
    "keytar@7.9.0": true
  }
}
